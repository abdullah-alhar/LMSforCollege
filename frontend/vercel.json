{
  "headers": [
    {
      "source": "/(sitemap.xml|sitemap-index.xml)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|sitemap-index.xml|robots.txt).*)",
      "destination": "/index.html"
    }
  ]
}
